@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix wgs: <https://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/rml/shapes/FnOConstantParameterTypeShape> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "A constant-valued parameter input must match the datatype the function declares via fno:type." ;
            sh:select """
            PREFIX rml: <http://w3id.org/rml/>
            PREFIX fno: <https://w3id.org/function/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rml:input ?input .
                ?input rml:parameter ?param ;
                       rml:inputValueMap ?ivm .
                ?ivm rml:constant ?val .
                GRAPH <urn:rml:functions> {
                    ?param fno:type ?expectedType .
                }
                FILTER (isLiteral(?val) && datatype(?val) != ?expectedType)
            }
        """ ] ;
    sh:targetSubjectsOf rml:function .

<http://w3id.org/rml/shapes/FnOFunctionExistsShape> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "rml:function must reference an fno:Function declared in the function library." ;
            sh:select """
            PREFIX rml: <http://w3id.org/rml/>
            PREFIX fno: <https://w3id.org/function/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rml:function ?func .
                FILTER NOT EXISTS {
                    GRAPH <urn:rml:functions> { ?func a fno:Function }
                }
            }
        """ ] ;
    sh:targetSubjectsOf rml:function .

<http://w3id.org/rml/shapes/FnONoDuplicateParameterShape> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "The same parameter must not be supplied more than once via rml:input/rml:parameter." ;
            sh:select """
            PREFIX rml: <http://w3id.org/rml/>
            SELECT DISTINCT $this
            WHERE {
                $this rml:input ?input1, ?input2 .
                ?input1 rml:parameter ?param .
                ?input2 rml:parameter ?param .
                FILTER (?input1 != ?input2)
            }
        """ ] ;
    sh:targetSubjectsOf rml:function .

<http://w3id.org/rml/shapes/FnOParameterValidShape> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "rml:parameter must be one of the function's declared fno:expects parameters." ;
            sh:select """
            PREFIX rml: <http://w3id.org/rml/>
            PREFIX fno: <https://w3id.org/function/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT DISTINCT $this
            WHERE {
                $this rml:function ?func ;
                      rml:input ?input .
                ?input rml:parameter ?param .
                FILTER NOT EXISTS {
                    GRAPH <urn:rml:functions> {
                        ?func fno:expects/rdf:rest*/rdf:first ?param .
                    }
                }
            }
        """ ] ;
    sh:targetSubjectsOf rml:function .

<http://w3id.org/rml/shapes/FnORequiredParametersSuppliedShape> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Every parameter the function declares as fno:required must be supplied via rml:input/rml:parameter." ;
            sh:select """
            PREFIX rml: <http://w3id.org/rml/>
            PREFIX fno: <https://w3id.org/function/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT DISTINCT $this
            WHERE {
                $this rml:function ?func .
                GRAPH <urn:rml:functions> {
                    ?func fno:expects/rdf:rest*/rdf:first ?reqParam .
                    ?reqParam fno:required true .
                }
                FILTER NOT EXISTS {
                    $this rml:input ?input .
                    ?input rml:parameter ?reqParam .
                }
            }
        """ ] ;
    sh:targetSubjectsOf rml:function .

<http://w3id.org/rml/shapes/FnOReturnValidShape> a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "rml:return must be one of the function's declared fno:returns outputs." ;
            sh:select """
            PREFIX rml: <http://w3id.org/rml/>
            PREFIX fno: <https://w3id.org/function/ontology#>
            PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
            SELECT $this
            WHERE {
                $this rml:functionExecution ?exec ;
                      rml:return ?ret .
                ?exec rml:function ?func .
                FILTER NOT EXISTS {
                    GRAPH <urn:rml:functions> {
                        ?func fno:returns/rdf:rest*/rdf:first ?ret .
                    }
                }
            }
        """ ] ;
    sh:targetSubjectsOf rml:functionExecution .

<http://w3id.org/rml/shapes/RMLAbstractExpressionMapValuePath> rdf:first rml:functionExecution ;
    rdf:rest () .

<http://w3id.org/rml/shapes/nonConstantExpressionAlternativeList> rdf:first rml:functionExecution ;
    rdf:rest () .

<http://w3id.org/rml/shapes/RMLAbstractExpressionMapShape> sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path [ sh:alternativePath ( rml:return rml:returnMap ) ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path rml:functionExecution ] ] ) ;
    sh:property [ rdfs:label "rml:condition" ;
            rdfs:comment """
        A shortcut on an Expression Map: its value must be a
        boolean-returning function-valued expression map. If the
        condition evaluates to true, the enclosing Expression Map's own
        value is used.
        """ ;
            sh:message """
        rml:condition must reference a valid, function-valued Expression Map.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLAbstractExpressionMapShape> ;
            sh:path rml:condition ],
        [ sh:node <http://w3id.org/rml/shapes/RMLFunctionExecutionShape> ;
            sh:path rml:functionExecution ],
        [ rdfs:label "rml:return/rml:returnMap" ;
            rdfs:comment """
        At most one of rml:return or rml:returnMap is allowed.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        At most one of rml:return or rml:returnMap is allowed.
        """ ;
            sh:path [ sh:alternativePath ( rml:return rml:returnMap ) ] ],
        [ rdfs:label "rml:returnMap" ;
            rdfs:comment """
        Selects which Return of the function's execution to use.
        """ ;
            sh:message """
        rml:returnMap must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLReturnMapShape> ;
            sh:path rml:returnMap ],
        [ rdfs:label "rml:return" ;
            rdfs:comment """
        Constant expression shortcut of rml:returnMap.
        """ ;
            sh:message """
        rml:return must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:return ] .

<http://w3id.org/rml/shapes/RMLFunctionExecutionShape> a sh:NodeShape ;
    rdfs:label "rml:FunctionExecution" ;
    rdfs:comment """
    Represents a Function Execution.
    """ ;
    sh:property [ rdfs:label "rml:function/rml:functionMap" ;
            rdfs:comment """
        Exactly one rml:function or rml:functionMap is required.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:function or rml:functionMap is required.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:function rml:functionMap ) ] ],
        [ rdfs:label "rml:functionMap" ;
            rdfs:comment """
        FnO function to execute.
        """ ;
            sh:message """
        rml:functionMap must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLFunctionMapShape> ;
            sh:path rml:functionMap ],
        [ rdfs:label "rml:function" ;
            rdfs:comment """
        FnO function to execute.
        """ ;
            sh:message """
        rml:function must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:function ],
        [ rdfs:label "rml:input" ;
            rdfs:comment """
        Input parameters for the function.
        """ ;
            sh:message """
        rml:input must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLInputShape> ;
            sh:path rml:input ] .

<http://w3id.org/rml/shapes/RMLFunctionMapShape> a sh:NodeShape ;
    rdfs:label "FunctionMap" ;
    rdfs:comment """
    Represents a Function Map.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> .

<http://w3id.org/rml/shapes/RMLInputShape> a sh:NodeShape ;
    rdfs:label "rml:Input" ;
    rdfs:comment """
    Represents an Input for a function.
    """ ;
    sh:property [ rdfs:label "rml:parameter/rml:parameterMap" ;
            rdfs:comment """
        Exactly one rml:parameter or rml:parameterMap is required.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:parameter or rml:parameterMap is required.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:parameter rml:parameterMap ) ] ],
        [ rdfs:label "rml:inputValueMap" ;
            rdfs:comment """
        Values of the parameters.
        """ ;
            sh:message """
        rml:inputValueMap must be an IRI or Blank node, provided once.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> ;
            sh:path rml:inputValueMap ],
        [ rdfs:label "rml:inputValue" ;
            rdfs:comment """
        Parameters to supply to FnO function.
        """ ;
            sh:datatype xsd:string ;
            sh:message """
        rml:inputValue must be a string Literal.
        """ ;
            sh:nodeKind sh:Literal ;
            sh:path rml:inputValue ],
        [ rdfs:label "rml:parameterMap" ;
            rdfs:comment """
        Parameters to supply to FnO function.
        """ ;
            sh:message """
        rml:parameterMap must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLParameterMapShape> ;
            sh:path rml:parameterMap ],
        [ rdfs:label "rml:parameter" ;
            rdfs:comment """
        Parameters to supply to FnO function.
        """ ;
            sh:message """
        rml:parameter must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:parameter ],
        [ rdfs:label "rml:inputValue/rml:inputValueMap" ;
            rdfs:comment """
        Exactly one rml:inputValue or rml:inputValueMap is required.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:inputValue or rml:inputValueMap is required.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:inputValue rml:inputValueMap ) ] ] .

<http://w3id.org/rml/shapes/RMLParameterMapShape> a sh:NodeShape ;
    rdfs:label "ParameterMap" ;
    rdfs:comment """
    Represents a Parameter Map of a function.
    """ ;
    sh:nodeKind sh:BlankNodeOrIRI .

<http://w3id.org/rml/shapes/RMLReturnMapShape> a sh:NodeShape ;
    rdfs:label "ReturnMap" ;
    rdfs:comment """
    Represents a Return Map.
    """ ;
    sh:and ( <http://w3id.org/rml/shapes/RMLTermMapShape> <http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape> [ ] ) ;
    sh:targetObjectsOf rml:returnMap .

