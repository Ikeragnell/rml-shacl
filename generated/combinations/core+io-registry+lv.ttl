_:n9e36a715bcee4b17bc1f70ac2d9c9a33b1 <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:Na5ce3d56cdbc4a3b89250df9c59e33f5 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> _:n474b4fb984df4247bf65f6c3d4a145a5b17 .
