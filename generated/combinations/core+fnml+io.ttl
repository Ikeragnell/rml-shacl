<http://w3id.org/rml/shapes/RMLTermMapShape> a sh:NodeShape ;
    rdfs:label "TermMap" ;
    rdfs:comment """
    Represents a Term Map.
    """ ;
    sh:message """
    Term Map is an Expression Map with optionally a term type specified.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLAbstractExpressionMapShape> ;
    sh:or ( [ sh:property [ rdfs:label "template/constant/reference" ;
                        rdfs:comment """
                Only one of rml:template, rml:constant, or rml:reference is
                allowed.
            """ ;
                        sh:message """
            Only one of rml:template, rml:constant, or rml:reference is allowed.
            """ ;
                        sh:minCount 1 ;
                        sh:path [ sh:alternativePath _:N2e904824c5a34c288fe4ef0585a25b41 ] ] ] [ sh:property [ sh:hasValue rml:BlankNode ;
                        sh:path rml:termType ] ] ),
        ( [ sh:property [ sh:maxCount 0 ;
                        sh:path rml:constant ] ] [ sh:property [ sh:maxCount 0 ;
                        sh:path rml:termType ] ] ) ;
    sh:property [ rdfs:label "rml:logicalTarget" ;
            rdfs:comment """
        A Term Map MAY contain one or more rml:logicalTarget properties to
        export all triples containing the generated term to different
        targets.
        """ ;
            sh:message """
        rml:logicalTarget must reference a valid RML Logical Target.
