@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix wgs: <https://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/rml/shapes/RMLStrategyShape> a sh:NodeShape ;
    rdfs:label "Strategy" .

<http://w3id.org/rml/shapes/RMLAbstractLogicalSourceShape> a sh:NodeShape ;
    rdfs:label "Abstract Logical Source" ;
    rdfs:comment """\r
    A sub-class of iterable that can be associated with a triples map such that a data source can be mapped to RDF triples.\r
    """ ;
    sh:message """\r
    rml:AbstractLogicalSource must specify how to generate logical iterations on a data source for a triples map.\r
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLIterableShape> ;
    sh:or ( [ sh:node <http://w3id.org/rml/shapes/RMLLogicalSourceShape> ] ) .

<http://w3id.org/rml/shapes/RMLChildMapShape> a sh:NodeShape ;
    rdfs:label "ChildMap" ;
    rdfs:comment """
    Represents a Child Map.
    """ ;
    sh:message """
    rml:ChildMap must specify a literal referencing data in the child data
    source.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLExpressionMapShape> .

<http://w3id.org/rml/shapes/RMLCurrentWorkingDirectoryShape> a sh:NodeShape ;
    sh:hasValue rml:CurrentWorkingDirectory .

<http://w3id.org/rml/shapes/RMLDatatypeMapShape> a sh:NodeShape ;
    rdfs:label "DatatypeMap" ;
    rdfs:comment """
    Represents a Datatype Map.
    """ ;
    sh:message """
    rml:DatatypeMap must specify an rml:template, rml:reference, or rml:constant
    with the IRI of the datatype.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> .

<http://w3id.org/rml/shapes/RMLFilePathShape> a sh:NodeShape ;
    sh:property [ rdfs:label "rml:path" ;
            rdfs:comment """
        rml:path specifies the file path, relative to rml:root if
        provided, or absolute otherwise.
        """ ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message """
        rml:path must be provided exactly once as a string Literal.
        """ ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rml:path ],
        [ rdfs:label "rml:root" ;
            rdfs:comment """
        rml:root defines the root against which a relative rml:path is
        resolved: rml:CurrentWorkingDirectory, rml:MappingDirectory, or an
        absolute path string Literal. Defaults to
        rml:CurrentWorkingDirectory if not specified.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:root must be rml:CurrentWorkingDirectory, rml:MappingDirectory,
        or a string Literal, and may be provided at most once.
        """ ;
            sh:path rml:root ;
            sh:xone ( [ sh:node <http://w3id.org/rml/shapes/RMLCurrentWorkingDirectoryShape> ] [ sh:node <http://w3id.org/rml/shapes/RMLMappingDirectoryShape> ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ] .

<http://w3id.org/rml/shapes/RMLFormatShape> a sh:NodeShape ;
    sh:nodeKind sh:IRI .

<http://w3id.org/rml/shapes/RMLFunctionExecutionShape> a sh:NodeShape ;
    rdfs:label "rml:FunctionExecution" ;
    rdfs:comment """
    Represents a Function Execution.
    """ ;
    sh:property [ rdfs:label "rml:function/rml:functionMap" ;
            rdfs:comment """
        Exactly one rml:function or rml:functionMap is required.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:function or rml:functionMap is required.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:function rml:functionMap ) ] ],
        [ rdfs:label "rml:functionMap" ;
            rdfs:comment """
        FnO function to execute.
        """ ;
            sh:message """
        rml:functionMap must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLFunctionMapShape> ;
            sh:path rml:functionMap ],
        [ rdfs:label "rml:function" ;
            rdfs:comment """
        FnO function to execute.
        """ ;
            sh:message """
        rml:function must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:function ],
        [ rdfs:label "rml:input" ;
            rdfs:comment """
        Input parameters for the function.
        """ ;
            sh:message """
        rml:input must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLInputShape> ;
            sh:path rml:input ] .

<http://w3id.org/rml/shapes/RMLFunctionMapShape> a sh:NodeShape ;
    rdfs:label "FunctionMap" ;
    rdfs:comment """
    Represents a Function Map.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> .

<http://w3id.org/rml/shapes/RMLGraphMapShape> a sh:NodeShape ;
    rdfs:label "GraphMap" ;
    rdfs:comment """
    Represents a Graph Map.
    """ ;
    sh:message """
    rml:GraphMap must specify an rml:template, rml:reference or rml:constant
    with the IRI of the Named Graph.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> ;
    sh:property [ sh:in ( rml:IRI rml:UnsafeIRI rml:URI rml:UnsafeURI rml:BlankNode ) ;
            sh:message """
        rml:termType must be an rml:IRI, rml:UnsafeIRI, rml:URI,
        rml:UnsafeURI, or rml:BlankNode for a Graph Map.
        """ ;
            sh:path rml:termType ] .

<http://w3id.org/rml/shapes/RMLInputShape> a sh:NodeShape ;
    rdfs:label "rml:Input" ;
    rdfs:comment """
    Represents an Input for a function.
    """ ;
    sh:property [ rdfs:label "rml:parameter/rml:parameterMap" ;
            rdfs:comment """
        Exactly one rml:parameter or rml:parameterMap is required.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:parameter or rml:parameterMap is required.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:parameter rml:parameterMap ) ] ],
        [ rdfs:label "rml:inputValueMap" ;
            rdfs:comment """
        Values of the parameters.
        """ ;
            sh:message """
        rml:inputValueMap must be an IRI or Blank node, provided once.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> ;
            sh:path rml:inputValueMap ],
        [ rdfs:label "rml:inputValue" ;
            rdfs:comment """
        Parameters to supply to FnO function.
        """ ;
            sh:message """
        rml:inputValue must be a string Literal.
        """ ;
            sh:path rml:inputValue ],
        [ rdfs:label "rml:parameterMap" ;
            rdfs:comment """
        Parameters to supply to FnO function.
        """ ;
            sh:message """
        rml:parameterMap must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLParameterMapShape> ;
            sh:path rml:parameterMap ],
        [ rdfs:label "rml:parameter" ;
            rdfs:comment """
        Parameters to supply to FnO function.
        """ ;
            sh:message """
        rml:parameter must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:parameter ],
        [ rdfs:label "rml:inputValue/rml:inputValueMap" ;
            rdfs:comment """
        Exactly one rml:inputValue or rml:inputValueMap is required.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:inputValue or rml:inputValueMap is required.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:inputValue rml:inputValueMap ) ] ] .

<http://w3id.org/rml/shapes/RMLIterableShape> a sh:NodeShape ;
    rdfs:label "Iterable" ;
    rdfs:comment """\r
    An abstract construct to describe data access and iteration for a data source.\r
    """ ;
    sh:message """\r
    Iterable must specify how to generate logical iterations on a data source.\r
    """ ;
    sh:property [ rdfs:label "rml:referenceFormulation" ;
            rdfs:comment """\r
        The reference formulation (rml:referenceFormulation) defines how to\r
        reference to elements of the data of the input source.\r
        """ ;
            sh:maxCount 1 ;
            sh:message """\r
        rml:referenceFormulation must be a blank node or IRI specifying the\r
        reference formulation on how to reference elements of a data source,\r
        and may be provided at most once.\r
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLReferenceFormulationShape> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path rml:referenceFormulation ],
        [ rdfs:label "rml:iterator" ;
            rdfs:comment """\r
        The logical iterator (rml:iterator) defines the iteration loop used to \r
        map the data of the input source. Depends on the reference formulation\r
        if an iterator is necessary.  \r
        """ ;
            sh:maxCount 1 ;
            sh:message """\r
        rml:iterator specifies the iterator to iterate over\r
        the data source, and may be provided at most once.\r
        """ ;
            sh:nodeKind sh:Literal ;
            sh:path rml:iterator ] .

<http://w3id.org/rml/shapes/RMLJoinShape> a sh:NodeShape ;
    rdfs:label "Join" ;
    rdfs:comment """
    Represents a Join.
    """ ;
    sh:message """
    rml:Join must specify exactly one rml:parent/rml:parentMap 
    and rml:child/rml:childMap.
    """ ;
    sh:property [ rdfs:label "parentMap/parent" ;
            rdfs:comment """
        rml:parent/rml:parentMap may only be provided once and 
        not at the same time.
        """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:parentMap rml:parent ) ] ],
        [ rdfs:label "childMap" ;
            rdfs:comment """
        Specifies the child of the object component for joining.
        """ ;
            sh:message """
        rml:childMap must point to a rml:ChildMap specifying the
        child of the Literal.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLChildMapShape> ;
            sh:path rml:childMap ],
        [ rdfs:label "child" ;
            rdfs:comment """
        Specifies the child of the object component for joining.
        """ ;
            sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path rml:child ],
        [ rdfs:label "parentMap" ;
            rdfs:comment """
        Specifies the parent of the object component for joining.
        """ ;
            sh:message """
        rml:parentMap must point to a rml:ParentMap specifying the 
        parent tag of the string Literal.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLParentMapShape> ;
            sh:path rml:parentMap ],
        [ rdfs:label "parent" ;
            rdfs:comment """
        Specifies the parent of the object component for joining.
        """ ;
            sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path rml:parent ],
        [ rdfs:label "childMap/child" ;
            rdfs:comment """
        rml:child/rml:childMap may only be provided once and 
        not at the same time.
        """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:childMap rml:child ) ] ] .

<http://w3id.org/rml/shapes/RMLLanguageMapShape> a sh:NodeShape ;
    rdfs:label "LanguageMap" ;
    rdfs:comment """
    Represents a Language Map.
    """ ;
    sh:message """
    rml:LanguageMap must specify an rml:template, rml:reference, or rml:constant
    with the BCP47 name of the language as string.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLExpressionMapShape> ;
    sh:property [ sh:path rml:constant ;
            sh:pattern "^((?:(en-GB-oed|i-ami|i-bnn|i-default|i-enochian|i-hak|i-klingon|i-lux|i-mingo|i-navajo|i-pwn|i-tao|i-tay|i-tsu|sgn-BE-FR|sgn-BE-NL|sgn-CH-DE)|(art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang))|((?:([A-Za-z]{2,3}(-(?:[A-Za-z]{3}(-[A-Za-z]{3}){0,2}))?)|[A-Za-z]{4})(-(?:[A-Za-z]{4}))?(-(?:[A-Za-z]{2}|[0-9]{3}))?(-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(-(?:[0-9A-WY-Za-wy-z](-[A-Za-z0-9]{2,8})+))*(-(?:x(-[A-Za-z0-9]{1,8})+))?)|(?:x(-[A-Za-z0-9]{1,8})+))$" ;
            sh:sparql [ a sh:SPARQLConstraint ;
                    sh:message "rml:constant of a LanguageMap must be a plain string, not a language-tagged literal." ;
                    sh:select """
                PREFIX rml: <http://w3id.org/rml/>
                SELECT $this
                WHERE {
                    $this rml:constant ?value .
                    FILTER (lang(?value) != "")
                }
            """ ] ] .

<http://w3id.org/rml/shapes/RMLLogicalSourceShape> a sh:NodeShape ;
    rdfs:label "RML Logical Source" ;
    rdfs:comment """
    A logical source is any source that is mapped to RDF triples.
    """ ;
    sh:message """
    RML Logical Source requires one rml:source and requires everyting
    an Abstract Logical Source requires.
    """ ;
    sh:property [ rdfs:label "rml:source" ;
            rdfs:comment """
        The source (rml:source) locates the input data source. It is a URI
        that represents the data source where the data source is.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:source must be provided to locate the data source.
        rml:source must be provided exactly once as an URI.
        """ ;
            sh:minCount 1 ;
            sh:node <http://w3id.org/rml/shapes/RMLSourceShape> ;
            sh:path rml:source ] .

<http://w3id.org/rml/shapes/RMLLogicalTargetShape> a sh:NodeShape ;
    rdfs:label "RML Logical Target" ;
    rdfs:comment """
    A logical target is any target to where generated RDF triples are exported
    to.
    """ ;
    sh:message """
    RML Logical Target requires one rml:target.
    """ ;
    sh:property [ rdfs:label "rml:target" ;
            rdfs:comment """
        The target (rml:target) locates the output target. It is a URI
        that represents the target where it must export generated RDF triples
        to.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:target must be provided to locate the target. rml:target must 
        be provided exactly once as an URI.
        """ ;
            sh:minCount 1 ;
            sh:node <http://w3id.org/rml/shapes/RMLTargetShape> ;
            sh:path rml:target ],
        [ rdfs:label "rml:serialization" ;
            rdfs:comment """
        A Target MAY describe the serialization format with
        rml:serialization to use when exporting RDF triples to a Target.
        Defaults to N-Quads if unspecified.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:serialization must be an IRI from the W3C formats namespace,
        and may be provided at most once.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLFormatShape> ;
            sh:path rml:serialization ] .

<http://w3id.org/rml/shapes/RMLMappingDirectoryShape> a sh:NodeShape ;
    sh:hasValue rml:MappingDirectory .

<http://w3id.org/rml/shapes/RMLModeShape> a sh:NodeShape ;
    sh:in ( rml:Read rml:ReadWrite rml:Write rml:WriteRead rml:Append rml:AppendRead ) .

<http://w3id.org/rml/shapes/RMLObjectMapShape> a sh:NodeShape ;
    rdfs:label "ObjectMap" ;
    rdfs:comment """
    Represents an Object Map.
    """ ;
    sh:message """
    Object Map must generate a IRI, Blank Node, or Literal which has optionally
    a language tag or datatype.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> ;
    sh:property [ rdfs:label "languageMap/datatypeMap/language/datatype" ;
            rdfs:comment """
        rml:language/rml:languageMap and rml:datatype/rml:datatypeMap
        may only be provided once and not at the same time.
        """ ;
            sh:maxCount 1 ;
            sh:minCount 0 ;
            sh:path [ sh:alternativePath ( rml:languageMap rml:datatypeMap rml:language rml:datatype ) ] ],
        [ rdfs:label "datatype" ;
            rdfs:comment """
        Datatype for the object.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:datatype ],
        [ rdfs:label "languageMap" ;
            rdfs:comment """
        Specified the language map for the object component for the 
        generated RDF triples.
        """ ;
            sh:message """
        rml:languageMap must point to a rml:LanguageMap specifying the 
        language tag of the string Literal.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLLanguageMapShape> ;
            sh:path rml:languageMap ],
        [ rdfs:label "datatypeMap" ;
            rdfs:comment """
        Specifies the datatype of the object component for the generated 
        RDF triples.
        """ ;
            sh:message """
        rml:datatypeMap must point to a rml:DatatypeMap specifying the
        datatype of the Literal.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLDatatypeMapShape> ;
            sh:path rml:datatypeMap ],
        [ rdfs:label "language" ;
            rdfs:comment """
        Language tag for the object.
        """ ;
            xsd:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:path rml:language ;
            sh:pattern "^((?:(en-GB-oed|i-ami|i-bnn|i-default|i-enochian|i-hak|i-klingon|i-lux|i-mingo|i-navajo|i-pwn|i-tao|i-tay|i-tsu|sgn-BE-FR|sgn-BE-NL|sgn-CH-DE)|(art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang))|((?:([A-Za-z]{2,3}(-(?:[A-Za-z]{3}(-[A-Za-z]{3}){0,2}))?)|[A-Za-z]{4})(-(?:[A-Za-z]{4}))?(-(?:[A-Za-z]{2}|[0-9]{3}))?(-(?:[A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(-(?:[0-9A-WY-Za-wy-z](-[A-Za-z0-9]{2,8})+))*(-(?:x(-[A-Za-z0-9]{1,8})+))?)|(?:x(-[A-Za-z0-9]{1,8})+))$" ] .

<http://w3id.org/rml/shapes/RMLParameterMapShape> a sh:NodeShape ;
    rdfs:label "ParameterMap" ;
    rdfs:comment """
    Represents a Parameter Map of a function.
    """ ;
    sh:nodeKind sh:BlankNodeOrIRI .

<http://w3id.org/rml/shapes/RMLParentMapShape> a sh:NodeShape ;
    rdfs:label "ParentMap" ;
    rdfs:comment """
    Represents a Parent Map.
    """ ;
    sh:message """
    rml:ParentMap must specify a literal referencing data in the parent data
    source.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLExpressionMapShape> .

<http://w3id.org/rml/shapes/RMLPredicateMapShape> a sh:NodeShape ;
    rdfs:label "PredicateMap" ;
    rdfs:comment """
    Represents a Predicate Map.
    """ ;
    sh:message """
    Predicate Object Map must generate an IRI representing the predicate of an
    RDF triple.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLTermMapShape> ;
    sh:property [ sh:in ( rml:IRI rml:UnsafeIRI rml:URI rml:UnsafeURI ) ;
            sh:message """
        rml:termType for Predicate Map can only be a rml:IRI, rml:UnsafeIRI,
        rml:URI, or rml:UnsafeURI;
        """ ;
            sh:path rml:termType ] .

<http://w3id.org/rml/shapes/RMLPredicateObjectMapShape> a sh:NodeShape ;
    rdfs:label "PredicateObjectMap" ;
    rdfs:comment """
    Represents a Predicate Object Map.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLSubjectMapORPredicateObjectMapShape> ;
    sh:property [ rdfs:label "predicate/predicateMap" ;
            rdfs:comment """
        At least one rml:predicate or rml:predicateMap must be provided.
        """ ;
            sh:message """
        At least one rml:predicate or rml:predicateMap must be provided.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:predicate rml:predicateMap ) ] ],
        [ rdfs:label "objectMap" ;
            rdfs:comment """
        An ObjectMap element to generate the object component of the 
        (predicate, object) pair from a logical table row or iterator.
        """ ;
            sh:message """
        rml:objectMap must be an IRI or blank node and be provided once.
        """ ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:node <http://w3id.org/rml/shapes/RMLObjectMapShape> ] [ sh:node <http://w3id.org/rml/shapes/RMLRefObjectMapShape> ] ) ;
            sh:path rml:objectMap ],
        [ rdfs:label "object" ;
            rdfs:comment """
        Specifies the object for the generated RDF triples.
        """ ;
            sh:message """
        rml:object must be an IRI and be provided once.
        """ ;
            sh:path rml:object ],
        [ rdfs:label "predicateMap" ;
            rdfs:comment """
        A PredicateMap element to generate the predicate component of the 
        (predicate, object) pair from a logical table row or iterator.
        """ ;
            sh:message """
        rml:predicateMap must be an IRI or blank node and be provided once.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLPredicateMapShape> ;
            sh:path rml:predicateMap ],
        [ rdfs:label "predicate" ;
            rdfs:comment """
        Specifies the predicate for the generated triple from the logical table 
        row or iterator.
        """ ;
            sh:message """
        rml:predicate must be an IRI and be provided once.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:predicate ],
        [ rdfs:label "object/objectMap" ;
            rdfs:comment """
        Either an rml:object or rml:objectMap must be provided, not multiple.
        """ ;
            sh:message """
        Either an rml:object or rml:objectMap must be provided, not multiple
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:object rml:objectMap ) ] ] .

<http://w3id.org/rml/shapes/RMLRefObjectMapShape> a sh:NodeShape ;
    rdfs:label "RefObjectMap" ;
    rdfs:comment """
    Represents a Reference Object Map.
    """ ;
    sh:message """
    rml:RefObjectMap must specify a rml:parentTriplesMap and zero or more 
    rml:joinConditions.
    """ ;
    sh:property [ rdfs:label "parentTriplesMap" ;
            rdfs:comment """
        Specifies the Triples Map element corresponding to the parent data
        source of the foreign key constraint.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:parentTriplesMap may only be provided once and must be an IRI
        or Blank Node referring to a Triples Map.
        """ ;
            sh:minCount 1 ;
            sh:node <http://w3id.org/rml/shapes/RMLTriplesMapShape> ;
            sh:path rml:parentTriplesMap ],
        [ rdfs:label "joinCondition" ;
            sh:node <http://w3id.org/rml/shapes/RMLJoinShape> ;
            sh:path rml:joinCondition ] .

<http://w3id.org/rml/shapes/RMLReferenceFormulationShape> a sh:NodeShape .

<http://w3id.org/rml/shapes/RMLReturnMapShape> a sh:NodeShape ;
    rdfs:label "ReturnMap" ;
    rdfs:comment """
    Represents a Return Map.
    """ ;
    sh:and ( <http://w3id.org/rml/shapes/RMLTermMapShape> <http://w3id.org/rml/shapes/RMLLogicalTargetPropertiesShape> [ ] ) ;
    sh:targetObjectsOf rml:returnMap .

<http://w3id.org/rml/shapes/RMLSourceShape> a sh:NodeShape ;
    rdfs:label "RML Source" ;
    rdfs:comment """
    A source describes access to a data source. Any data access description
    is allowed, but rml:Source provides additional properties to complete
    such descriptions.
    """ ;
    sh:message """
    RML Source accepts one or multiple rml:null, one rml:compression,
    and one rml:encoding. All of them are optional.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLSourceTargetShape> ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [ rdfs:label "rml:null" ;
            rdfs:comment """
        rml:null specifies how NULL or empty values are exposed by the data 
        source.
        """ ;
            sh:datatype xsd:string ;
            sh:message """
        rml:source must be provided as a string Literal.
        """ ;
            sh:minCount 0 ;
            sh:nodeKind sh:Literal ;
            sh:path rml:null ] .

<http://w3id.org/rml/shapes/RMLSourceTargetShape> a sh:NodeShape ;
    sh:property [ rdfs:label "rml:compression" ;
            rdfs:comment """
        rml:compression specifies the compression algorithm to use when
        accessing the data source. By default, no compression is applied.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:compression must be provided as an IRI.
        """ ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path rml:compression ],
        [ rdfs:label "rml:encoding" ;
            rdfs:comment """
        rml:encoding specifies the encoding to use when accessing the data 
        source. By default, UTF-8 is used.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:encoding must be provided as an IRI.
        """ ;
            sh:minCount 0 ;
            sh:nodeKind sh:IRI ;
            sh:path rml:encoding ] ;
    sh:xone ( [ sh:property [ sh:maxCount 0 ;
                        sh:path [ sh:alternativePath ( rml:root rml:path ) ] ] ] [ sh:node <http://w3id.org/rml/shapes/RMLFilePathShape> ] ) .

<http://w3id.org/rml/shapes/RMLSubjectMapShape> a sh:NodeShape ;
    rdfs:label "SubjectMap" ;
    rdfs:comment """
    Represents a Subject Map.
    """ ;
    sh:message """
    Subject Map must generate a resource representing the subject of
    an RDF triple.
    """ ;
    sh:node <http://w3id.org/rml/shapes/RMLSubjectMapORPredicateObjectMapShape>,
        <http://w3id.org/rml/shapes/RMLTermMapShape> ;
    sh:property [ rdfs:label "class" ;
            rdfs:comment """
        The subject value generated will be asserted as an instance of this
        RDFS class.
        """ ;
            sh:message """
        rml:class must be an IRI and may be specified multiple times.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:class ],
        [ sh:in ( rml:IRI rml:UnsafeIRI rml:URI rml:UnsafeURI rml:BlankNode ) ;
            sh:message """
        rml:termType must be a rml:IRI, rml:UnsafeIRI, rml:URI,
        rml:UnsafeURI, or rml:BlankNode for a Subject Map.
        """ ;
            sh:path rml:termType ] .

<http://w3id.org/rml/shapes/RMLTargetShape> a sh:NodeShape ;
    rdfs:label "RML Target" ;
    rdfs:comment """
    A target describes access to a data target. Any data access description
    is allowed, but rml:Target provides additional properties to complete
    such descriptions.
    """ ;
    sh:message """
    RML Target accepts one rml:compression, and one rml:encoding.
    All of them are optional.
    """ ;
    sh:property [ rdfs:label "rml:mode" ;
            rdfs:comment """
        rml:mode specifies in which mode the target is opened such as read-only,
        write-only, both, etc.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:mode must be specified by any of the modes from rml:Mode class.
        """ ;
            sh:minCount 0 ;
            sh:node <http://w3id.org/rml/shapes/RMLModeShape> ;
            sh:path rml:mode ] .

<http://w3id.org/rml/shapes/RMLTriplesMapShape> a sh:NodeShape ;
    rdfs:label "TriplesMap" ;
    rdfs:comment """
    Represents a Triples Map.
    """ ;
    sh:message """
    Triples Map requires exactly one rml:subject or one rml:subjectMap and zero
    or more rml:predicateObjectMaps.
    """ ;
    sh:or ( [ sh:minCount 1 ;
                sh:path rml:logicalSource ] [ sh:maxCount 0 ;
                sh:path [ sh:alternativePath ( ( [ sh:alternativePath _:N283896c78dbd458497a03a2415e78703 ] [ sh:alternativePath _:Nc141a2f353ff49db9c051aa72906ef28 ] [ sh:alternativePath _:N3152f0ac70b74c71ad030552460fbbcf ] ) ( [ sh:alternativePath _:N283896c78dbd458497a03a2415e78703 ] [ sh:alternativePath _:N3152f0ac70b74c71ad030552460fbbcf ] ) ) ] ] ) ;
    sh:property [ rdfs:label "logicalSource" ;
            rdfs:comment """
        A logical source is any source that is mapped to RDF triples.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Exactly one rml:logicalSource is required to access the data source.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLAbstractLogicalSourceShape> ;
            sh:path rml:logicalSource ],
        [ rdfs:label "subjectMap" ;
            rdfs:comment """
        A Subject Map element to generate a subject for generated RDF triples.
        """ ;
            sh:message """
        rml:SubjectMap must be an IRI or blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLSubjectMapShape> ;
            sh:path rml:subjectMap ],
        [ rdfs:label "subject" ;
            rdfs:comment """
        An IRI reference for use as subject for all generated RDF triples.
        """ ;
            sh:message """
        rml:subject must be an IRI or blank node.
        """ ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path rml:subject ],
        [ rdfs:label "predicateObjectMap" ;
            rdfs:comment """
        A Predicate Object Map element to generate a (predicate, object) pair.
        """ ;
            sh:message """
        rml:PredicateObjectMap must be an IRI or blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLPredicateObjectMapShape> ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path rml:predicateObjectMap ],
        [ sh:description """
        Base IRI to use for generating RDF triples or quads.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        rml:baseIRI must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:baseIRI ],
        [ rdfs:label "subjectMap/subject" ;
            rdfs:comment """
        Either a rml:subject, rml:subjectMap is required, not multiple.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Either a rml:subject, rml:subjectMap is required, not multiple.
        """ ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( rml:subjectMap rml:subject ) ] ] ;
    sh:targetClass rml:TriplesMap ;
    sh:targetObjectsOf rml:parentTriplesMap ;
    sh:targetSubjectsOf rml:baseIRI,
        rml:logicalSource,
        rml:predicateObjectMap,
        rml:subject,
        rml:subjectMap .

<http://w3id.org/rml/shapes/RMLSubjectMapORPredicateObjectMapShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:path [ sh:alternativePath ( rml:graph rml:graphMap ) ] ],
        [ sh:node <http://w3id.org/rml/shapes/RMLGraphMapShape> ;
            sh:path rml:graphMap ],
        [ sh:nodeKind sh:BlankNodeOrIRI ;
            sh:path rml:graph ] .

<http://w3id.org/rml/shapes/RMLAbstractExpressionMapShape> a sh:NodeShape ;
    rdfs:label "ExpressionMap" ;
    rdfs:comment """
    Represents a Expression Map.
    """ ;
    sh:message """
    Expression Map must have one of rml:template, rml:constant, or
    rml:reference, unless rml:termType is rml:BlankNode with no expression.
    """ ;
    sh:or ( [ sh:property [ sh:maxCount 0 ;
                        sh:path [ sh:alternativePath ( rml:return rml:returnMap ) ] ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path rml:functionExecution ] ] ) ;
    sh:property [ rdfs:label "template/constant/reference" ;
            rdfs:comment """
            Only one of rml:template, rml:constant, or rml:reference is
            allowed.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        Only one of rml:template, rml:constant, or rml:reference is allowed.
        """ ;
            sh:minCount 0 ;
            sh:path [ sh:alternativePath _:N2e904824c5a34c288fe4ef0585a25b41 ] ],
        [ rdfs:label "template" ;
            rdfs:comment """
        A template (format string) to specify how to generate a value for a 
        subject, predicate, or object, using one or more columns from a logical
        table row or iterator.
        """ ;
            sh:datatype xsd:string ;
            sh:message """
        rml:template must be a string with well-formed brace delimiters:
        every unescaped '{' must be closed by an unescaped '}' with no
        unescaped braces in between, and every literal '{', '}', or '\\'
        (both inside and outside reference expressions) must be
        backslash-escaped.
        """ ;
            sh:nodeKind sh:Literal ;
            sh:path rml:template ;
            sh:pattern "^(?:[^\\\\{}]|\\\\.|\\{(?:[^\\\\{}]|\\\\.)*\\})+$" ],
        [ rdfs:label "constant" ;
            rdfs:comment """
        A property for indicating whether a term map is a constant-valued term 
        map.
        """ ;
            sh:message """
        rml:constant must be an IRI or Literal.
        """ ;
            sh:path rml:constant ],
        [ rdfs:label "reference" ;
            rdfs:comment """
        A reference rml:reference is used to refer to a column in case of 
        databases, a record in case of CSV or TSV data source, an element in 
        case of XML data source, an object in case of a JSON data source, etc.

        A reference must be a valid identifier, considering the reference 
        formulation (rml:referenceFormulation) specified. The reference can be
        an absolute path, or a path relative to the iterator specified at the 
        logical source. 
        """ ;
            sh:datatype xsd:string ;
            sh:message """
        rml:reference must be a string.
        """ ;
            sh:nodeKind sh:Literal ;
            sh:path rml:reference ],
        [ rdfs:label "rml:condition" ;
            rdfs:comment """
        A shortcut on an Expression Map: its value must be a
        boolean-returning function-valued expression map. If the
        condition evaluates to true, the enclosing Expression Map's own
        value is used.
        """ ;
            sh:message """
        rml:condition must reference a valid, function-valued Expression Map.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLAbstractExpressionMapShape> ;
            sh:path rml:condition ],
        [ sh:node <http://w3id.org/rml/shapes/RMLFunctionExecutionShape> ;
            sh:path rml:functionExecution ],
        [ rdfs:label "rml:return/rml:returnMap" ;
            rdfs:comment """
        At most one of rml:return or rml:returnMap is allowed.
        """ ;
            sh:maxCount 1 ;
            sh:message """
        At most one of rml:return or rml:returnMap is allowed.
        """ ;
            sh:path [ sh:alternativePath ( rml:return rml:returnMap ) ] ],
        [ rdfs:label "rml:returnMap" ;
            rdfs:comment """
        Selects which Return of the function's execution to use.
        """ ;
            sh:message """
        rml:returnMap must be an IRI or Blank node.
        """ ;
            sh:node <http://w3id.org/rml/shapes/RMLReturnMapShape> ;
            sh:path rml:returnMap ],
        [ rdfs:label "rml:return" ;
            rdfs:comment """
        Constant expression shortcut of rml:returnMap.
        """ ;
            sh:message """
        rml:return must be an IRI.
        """ ;
            sh:nodeKind sh:IRI ;
            sh:path rml:return ] .

<http://w3id.org/rml/shapes/RMLExpressionMapShape> a sh:NodeShape ;
    rdfs:label "ExpressionMap" ;
    sh:node <http://w3id.org/rml/shapes/RMLAbstractExpressionMapShape> ;
