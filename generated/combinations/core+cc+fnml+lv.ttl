    rdf:rest ( rml:constant rml:reference ) .

_:N1e293bfdf96b45fe96fc6e64b93987cb rdf:first ( rml:gather ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ) ;
    rdf:rest ( ( rml:gather ( [ sh:zeroOrMorePath rdf:rest ] rdf:first _:N7de423dd036e414ab1b434ab38c6e94b ) ) ) .

_:N5029a647ac624dcfb2948077d26469b1 rdf:first [ sh:alternativePath _:N1e293bfdf96b45fe96fc6e64b93987cb ] ;
    rdf:rest ( rml:datatypeMap ( rml:joinCondition [ sh:alternativePath ( rml:childMap rml:parentMap ) ] ) ) .

_:N6df7cdae14f74cb7b5c0b5e61a19d085 rdf:first ( [ sh:zeroOrMorePath rml:condition ] rml:functionExecution [ sh:alternativePath ( rml:functionMap ( rml:input [ sh:alternativePath ( rml:parameterMap rml:inputValueMap ) ] ) ) ] ) ;
    rdf:rest () .

_:Nb4b4c54aea3142b6a27ec5b83d6ac076 rdf:first rml:languageMap ;
    rdf:rest _:N5029a647ac624dcfb2948077d26469b1 .

_:Nc7912c1a0f6949a08af76ee52b030b32 rdf:first ( rml:predicateObjectMap [ sh:alternativePath ( rml:predicateMap rml:objectMap ( rml:objectMap [ sh:alternativePath _:Nb4b4c54aea3142b6a27ec5b83d6ac076 ] ) ) ] ) ;
    rdf:rest () .

_:n5f95c6a875c54739ae458065bdfcce59b7 sh:zeroOrMorePath rml:condition .

_:N08fc866d8fdc441f9ace28ee95d0da10 rdf:first rml:subjectMap ;
    rdf:rest _:Nc7912c1a0f6949a08af76ee52b030b32 .

_:N3826632224f9409bb840870f8f221c4f rdf:first rml:template ;
    rdf:rest _:N08a71fb431384dcba7383e799b8673cf .

_:N7de423dd036e414ab1b434ab38c6e94b rdf:first _:n5f95c6a875c54739ae458065bdfcce59b7 ;
    rdf:rest _:N6df7cdae14f74cb7b5c0b5e61a19d085 .

_:N3bf7d94ce6d74281b68db8682e548e47 rdf:first rml:functionExecution ;
    rdf:rest _:N1849dab5b5a141e8909d55eb25239d7c .

