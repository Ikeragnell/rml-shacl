_:n0b9bacd63376491197371c0e4ade89afb1 <http://www.w3.org/ns/shacl#message> "\r\n        Exactly one rml:fieldName property must be specified for a rml:Field, with a string as its value.\r\n        " .
_:ne450e0723a6d46d09359bcb69e21353cb26 <http://www.w3.org/ns/shacl#select> "\n            PREFIX rml: <http://w3id.org/rml/>\n            SELECT DISTINCT $this\n            WHERE {\n                $this (rml:field|((rml:leftJoin|rml:innerJoin)/rml:field)) ?f1 .\n                $this (rml:field|((rml:leftJoin|rml:innerJoin)/rml:field)) ?f2 .\n                ?f1 rml:fieldName ?name .\n                ?f2 rml:fieldName ?name .\n                FILTER (?f1 != ?f2)\n            }\n        " .
_:n184b62827dae4c8d9c7684bbc16878aeb2 <http://www.w3.org/ns/shacl#alternativePath> _:n184b62827dae4c8d9c7684bbc16878aeb3 .
