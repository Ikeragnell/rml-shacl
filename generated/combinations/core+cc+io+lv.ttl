_:Ne4fc00d989ed4f7b920048947bcefc3a <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> <http://w3id.org/rml/constant> .
_:na81235464c934b31a7a3a81f05908382b26 <http://www.w3.org/ns/shacl#select> "\n            PREFIX rml: <http://w3id.org/rml/>\n            SELECT DISTINCT $this\n            WHERE {\n                $this (rml:field|((rml:leftJoin|rml:innerJoin)/rml:field)) ?f1 .\n                $this (rml:field|((rml:leftJoin|rml:innerJoin)/rml:field)) ?f2 .\n                ?f1 rml:fieldName ?name .\n                ?f2 rml:fieldName ?name .\n                FILTER (?f1 != ?f2)\n            }\n        " .
_:n1f6073457a6c457882e8e8f1752ace26b1 <http://www.w3.org/ns/shacl#in> _:n1f6073457a6c457882e8e8f1752ace26b2 .
