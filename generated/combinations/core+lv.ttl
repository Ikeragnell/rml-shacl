_:n6e4bbed1dbc245d9a15dde13ce3a93d9b6 <http://www.w3.org/ns/shacl#alternativePath> _:n6e4bbed1dbc245d9a15dde13ce3a93d9b7 .
_:n6591fd558470403d983824c650019933b2 <http://www.w3.org/ns/shacl#minCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
<http://w3id.org/rml/shapes/RMLSubjectMapORPredicateObjectMapShape> <http://www.w3.org/ns/shacl#property> _:n661bfb5d91c643d4ab906ffa80abae88b5 .
_:nd271b2be618342ad82d1e2c2515ae929b1 <http://www.w3.org/2000/01/rdf-schema#comment> "\n        rml:language/rml:languageMap and rml:datatype/rml:datatypeMap\n        may only be provided once and not at the same time.\n        " .
_:n282791abb5e24d4c83f2f6e7a87242d5b10 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:n661bfb5d91c643d4ab906ffa80abae88b5 <http://www.w3.org/ns/shacl#node> <http://w3id.org/rml/shapes/RMLGraphMapShape> .
_:n2108547d52574999bf8c1c628667deedb15 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> <http://www.w3.org/1999/02/22-rdf-syntax-ns#nil> .
_:nd271b2be618342ad82d1e2c2515ae929b5 <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:nd271b2be618342ad82d1e2c2515ae929b6 .
_:nd271b2be618342ad82d1e2c2515ae929b8 <http://www.w3.org/ns/shacl#message> "\n        rml:datatypeMap must point to a rml:DatatypeMap specifying the\n        datatype of the Literal.\n        " .
_:na07168091793425e91689eaf5256a943b4 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> <http://w3id.org/rml/UnsafeIRI> .
<http://w3id.org/rml/shapes/RMLAbstractLogicalSourceShape> <http://www.w3.org/ns/shacl#node> <http://w3id.org/rml/shapes/RMLIterableShape> .
_:n72cd13b3f6cf4b7a8c20e19891c0e418b26 <http://www.w3.org/ns/shacl#select> "\n            PREFIX rml: <http://w3id.org/rml/>\n            SELECT DISTINCT $this\n            WHERE {\n                $this (rml:field|((rml:leftJoin|rml:innerJoin)/rml:field)) ?f1 .\n                $this (rml:field|((rml:leftJoin|rml:innerJoin)/rml:field)) ?f2 .\n                ?f1 rml:fieldName ?name .\n                ?f2 rml:fieldName ?name .\n                FILTER (?f1 != ?f2)\n            }\n        " .
_:n1af04b2bf87d470dbefec6d09bb56ac9b1 <http://www.w3.org/2000/01/rdf-schema#label> "rml:referenceFormulation" .
_:n21e954a78f3545e3a3eada40ed5eb2b5b2 <http://www.w3.org/ns/shacl#select> "\n                PREFIX rml: <http://w3id.org/rml/>\n                SELECT $this\n                WHERE {\n                    $this rml:constant ?value .\n                    FILTER (lang(?value) != \"\")\n                }\n            " .
<http://w3id.org/rml/shapes/RMLPredicateMapShape> <http://www.w3.org/ns/shacl#node> <http://w3id.org/rml/shapes/RMLTermMapShape> .
<http://w3id.org/rml/shapes/RMLStrategyShape> <http://www.w3.org/2000/01/rdf-schema#label> "Strategy" .
