_:n007630702c974dd6a0f5ddd8e453d887b18 <http://www.w3.org/ns/shacl#path> <http://w3id.org/rml/termType> .
_:ncc4f6af6c9c1437fab4febbd76ce0e8eb1 <http://www.w3.org/ns/shacl#maxCount> "1"^^<http://www.w3.org/2001/XMLSchema#integer> .
_:nc52e49f8f7b24f3d99a1f2f86c3cbfa1b12 <http://www.w3.org/ns/shacl#message> "\n        rml:subject must be an IRI or blank node.\n        " .
