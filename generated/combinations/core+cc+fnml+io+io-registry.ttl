_:n78f652ba8ba34e7ca2635699e4a70902b2 <http://www.w3.org/2000/01/rdf-schema#label> "rml:iterator" .
_:na0c9f0930a574d89a667fa6490058ee3b2 <http://www.w3.org/ns/shacl#select> "\n                PREFIX rml: <http://w3id.org/rml/>\n                SELECT $this\n                WHERE {\n                    $this rml:constant ?value .\n                    FILTER (lang(?value) != \"\")\n                }\n            " .
