# @prefix sh: <http://www.w3.org/ns/shacl#> .
# @prefix rml: <http://w3id.org/rml/> .
# @prefix fno: <https://w3id.org/function/ontology#> .
# @prefix : <http://w3id.org/rml/shapes/> .

# # Cross-document checks against an FnO function-description document,
# # assumed loaded into the named graph <rml/functions> alongside the
# # mapping (in the default graph) being validated. This is a different KIND
# # of check than the rest of shapes_node: it depends on an external graph
# # rather than being self-contained within the mapping document, so it
# # deliberately uses independent sh:targetSubjectsOf targeting rather than
# # the head-attachment/no-independent-targeting convention used elsewhere.
# # Not part of the structural conformance suite -- exploratory.

# :FnOFunctionExistsShape
#     a sh:NodeShape ;
#     sh:targetSubjectsOf rml:function ;
#     sh:sparql [
#         a sh:SPARQLConstraint ;
#         sh:message "rml:function must reference an fno:Function declared in the function library." ;
#         sh:select """
#             PREFIX rml: <http://w3id.org/rml/>
#             PREFIX fno: <https://w3id.org/function/ontology#>
#             PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
#             SELECT $this
#             WHERE {
#                 $this rml:function ?func .
#                 FILTER NOT EXISTS {
#                     GRAPH <urn:rml:functions> { ?func a fno:Function }
#                 }
#             }
#         """ ;
#     ] .

